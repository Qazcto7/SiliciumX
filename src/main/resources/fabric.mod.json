{
	"schemaVersion": 1,
	"id": "siliciumx",
	"version": "${version}",
	"name": "SiliciumX",
	"description": "Universal, vanilla-faithful CPU, GPU, and memory performance mod for Fabric 26.3. Sodium-friendly with automatic companion-mod conflict avoidance.",
	"authors": [
		"Qazcto7"
	],
	"contact": {
		"homepage": "https://github.com/Qazcto7/SiliciumX",
		"sources": "https://github.com/Qazcto7/SiliciumX",
		"issues": "https://github.com/Qazcto7/SiliciumX/issues"
	},
	"license": "MIT",
	"icon": "assets/siliciumx/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.siliciumx.SiliciumXMod"
		],
		"client": [
			"dev.siliciumx.client.SiliciumXClientMod"
		],
		"modmenu": [
			"dev.siliciumx.client.compat.SiliciumXModMenuIntegration"
		]
	},
	"mixins": [
		"siliciumx.mixins.json",
		{
			"config": "siliciumx.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25"
	},
	"suggests": {
		"sodium": "*",
		"modmenu": "*"
	}
}
